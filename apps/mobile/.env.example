# Copy to .env. Dev builds read it through Metro; EAS builds use EAS
# environment variables, so a new EXPO_PUBLIC_ variable goes there too.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# RevenueCat public iOS key (appl_...). Without it the build sells nothing.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
# Read at prebuild into Info.plist, so a new key needs a new native build.
EXPO_PUBLIC_TIKTOK_CLIENT_KEY=
