{
  "expo": {
    "name": "LiftCamp",
    "slug": "liftcamp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "liftcamp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": {
        "light": "./assets/images/icon.png",
        "tinted": "./assets/images/icon-tinted.png"
      },
      "bundleIdentifier": "app.liftcamp.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "instagram-stories"
        ]
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1B5FA8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.liftcamp.mobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FDFCFB",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#221F1B"
          },
          "ios": {
            "image": "./assets/images/splash-wordmark.png",
            "dark": {
              "image": "./assets/images/splash-wordmark-dark.png"
            }
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.934572382456-udirhlefneir7hiju5rrqs28herj4nue"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "30d65a14-9109-4c11-b906-d98611e41325"
      }
    },
    "owner": "liftcamp"
  }
}
